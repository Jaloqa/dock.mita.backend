{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "ElasticApm": {
    "CaptureBody": "off",
    "CaptureHeaders": true,
    "SanitizeFieldNames": "password, passwd, pwd, secret, *key, *token*, *session*, *credit*, *card*, *auth*, set-cookie, *principal*, cookie, mita_*, xsrf*"
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "SessionPermitLimit": 60
  },
  "Rates": {
    "SyncEnabled": true,
    "SyncInterval": "06:00:00",
    "HistoryDays": 183,
    "NbpBaseUrl": "https://api.nbp.pl/api/"
  },
  "AllowedHosts": "*"
}
